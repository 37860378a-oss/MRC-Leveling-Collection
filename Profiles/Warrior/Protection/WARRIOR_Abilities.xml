    <Lua>if not MRC then
 MRC={}
 MRC.Book={}
 function MRC.Refresh()
  MRC.Book={}
  if not GetSpellName then return end
  for i=1,300 do local n=GetSpellName(i,BOOKTYPE_SPELL); if not n then break end; MRC.Book[n]=true end
 end
 function MRC.Known(n) if not MRC.Book or not next(MRC.Book) then MRC.Refresh() end; return MRC.Book[n]==true end
 function MRC.ValidTarget()
  return UnitExists("target") and UnitCanAttack("player","target") and not UnitIsDeadOrGhost("target")
 end
 function MRC.Cast(n,aoe)
  if StopRota or not MRC.Known(n) then return false end
  if aoe and not IsShiftKeyDown() then return false end
  if not aoe and IsShiftKeyDown() then return false end
  if UnitCastingInfo("player") or UnitChannelInfo("player") then return false end
  if not MRC.ValidTarget() or not IsUsableSpell(n) then return false end
  local s,d=GetSpellCooldown(n)
  if s and d and d&gt;1.6 and s+d&gt;GetTime() then return false end
  if IsSpellInRange(n,"target")==0 then return false end
  CastSpellByName(n)
  return true
 end
end
return false</Lua><RecastDelay>0</RecastDelay><Target>Custom</Target><CancelChannel>False</CancelChannel><LuaBefore /><LuaAfter />
